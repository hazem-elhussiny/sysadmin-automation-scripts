  (function(){
    const overlay = document.getElementById('drawerOverlay');
    const drawer = document.getElementById('sideDrawer');
    const dBadge = document.getElementById('dBadge');
    const dTitle = document.getElementById('dTitle');
    const dSubtitle = document.getElementById('dSubtitle');
    const dOverview = document.getElementById('dOverview');
    const dSkills = document.getElementById('dSkills');
    const dSkillsSection = document.getElementById('dSkillsSection');
    const dTerminalSection = document.getElementById('dTerminalSection');
    const dTerminalCode = document.getElementById('dTerminalCode');
    const closeBtn = document.getElementById('drawerCloseBtn');
    const copyBtn = document.getElementById('copyTerminalBtn');

    function openDrawer(key){
      const data = topicData[key];
      if(!data) return;
      dTitle.textContent = data.title;
      dSubtitle.textContent = data.subtitle;
      dOverview.textContent = data.overview;
      dBadge.textContent = data.badge;
      dBadge.style.background = data.color;

      if(data.code){
        dTerminalSection.style.display = '';
        dSkillsSection.style.display = 'none';
        dTerminalCode.textContent = data.code;
      } else {
        dSkillsSection.style.display = '';
        dTerminalSection.style.display = 'none';
        dSkills.innerHTML = '';
        (data.skills || []).forEach(skill=>{
          const li = document.createElement('li');
          li.textContent = skill;
          dSkills.appendChild(li);
        });
      }

      overlay.classList.add('active');
      drawer.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer(){
      overlay.classList.remove('active');
      drawer.classList.remove('active');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.js-topic').forEach(card=>{
      card.addEventListener('click', ()=>openDrawer(card.dataset.key));
    });
    overlay.addEventListener('click', closeDrawer);
    closeBtn.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', e=>{ if(e.key === 'Escape') closeDrawer(); });

    copyBtn.addEventListener('click', ()=>{
      navigator.clipboard.writeText(dTerminalCode.textContent).then(()=>{
        copyBtn.textContent = 'تم النسخ ✅';
        copyBtn.classList.add('copied');
        setTimeout(()=>{ copyBtn.textContent = 'نسخ الأوامر 📋'; copyBtn.classList.remove('copied'); }, 1600);
      });
    });
  })();

  document.querySelectorAll('.path-node[data-track]').forEach(node=>{
    node.addEventListener('click', ()=>{
      const target = document.getElementById(node.dataset.track);
      if(target) target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    });
  });

  if(reduceMotion || !('IntersectionObserver' in window)){
    document.querySelectorAll('.track').forEach(t=>t.classList.add('reveal'));
  } else {
    const revealIo = new IntersectionObserver((entries)=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting){ entry.target.classList.add('reveal'); revealIo.unobserve(entry.target); }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.track').forEach(t=>revealIo.observe(t));
  }

  (function(){
    const lane = document.getElementById('fwLane');
    if(!lane) return;
    const shield = lane.querySelector('.fw-shield');
    const statusText = document.getElementById('fwStatusText');
    const attackBtn = document.getElementById('fwAttackBtn');
    let attackMode = false;

    function createPacket(){
      const isAllowed = attackMode ? Math.random() < 0.2 : Math.random() < 0.75;
      const packet = document.createElement('div');
      packet.className = `fw-packet ${isAllowed ? 'allow' : 'block'}`;
      lane.appendChild(packet);
      requestAnimationFrame(()=>{ packet.style.right = isAllowed ? '100%' : '50%'; });
      setTimeout(()=>{
        packet.style.opacity = '0';
        setTimeout(()=>packet.remove(), 300);
      }, isAllowed ? 1200 : 600);
    }
    if(reduceMotion){ createPacket(); } else { setInterval(createPacket, 400); }

    attackBtn.addEventListener('click', ()=>{
      if(attackMode) return;
      attackMode = true;
      attackBtn.disabled = true;
      if(shield) shield.classList.add('under-attack');
      statusText.textContent = 'تحذير: جاري صد هجوم شبكي مكثف!';
      statusText.style.color = 'var(--rose)';
      setTimeout(()=>{
        attackMode = false;
        if(shield) shield.classList.remove('under-attack');
        statusText.textContent = 'نشط (تصفية حركة المرور)';
        statusText.style.color = 'var(--emerald)';
        attackBtn.disabled = false;
      }, 5000);
    });
  })();

  (function(){
    const canvas = document.getElementById('webCanvas');
    if(!canvas || reduceMotion) return;
    const ctx = canvas.getContext('2d');
    let width, height, nodes = [];
    const mouse = { x: null, y: null, radius: 150 };

    window.addEventListener('mousemove', e=>{ mouse.x = e.clientX; mouse.y = e.clientY; });
    window.addEventListener('mouseleave', ()=>{ mouse.x = null; mouse.y = null; });

    function initNodes(){
      nodes = [];
      const nodeCount = Math.min(160, Math.floor((width * height) / 18000));
      for(let i=0;i<nodeCount;i++){
        nodes.push({
          x: Math.random()*width, y: Math.random()*height,
          vx: (Math.random()-0.5)*0.8, vy: (Math.random()-0.5)*0.8,
          radius: Math.random()*2 + 1.5
        });
      }
    }
    function resizeCanvas(){
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      initNodes();
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function animateWeb(){
      ctx.clearRect(0,0,width,height);
      const isNight = root.getAttribute('data-theme') === 'night';
      const strokeColor = isNight ? 'rgba(56, 189, 248,' : 'rgba(2, 132, 199,';

      for(let i=0;i<nodes.length;i++){
        const node = nodes[i];
        node.x += node.vx; node.y += node.vy;
        if(node.x < 0 || node.x > width) node.vx *= -1;
        if(node.y < 0 || node.y > height) node.vy *= -1;

        ctx.fillStyle = strokeColor + '0.5)';
        ctx.beginPath(); ctx.arc(node.x, node.y, node.radius, 0, Math.PI*2); ctx.fill();

        for(let j=i+1;j<nodes.length;j++){
          const other = nodes[j];
          const dx = node.x-other.x, dy = node.y-other.y;
          const dist = Math.sqrt(dx*dx+dy*dy);
          if(dist < 120){
            ctx.strokeStyle = strokeColor + ((1-dist/120)*0.25) + ')';
            ctx.lineWidth = 0.8;
            ctx.beginPath(); ctx.moveTo(node.x,node.y); ctx.lineTo(other.x,other.y); ctx.stroke();
          }
        }
        if(mouse.x !== null){
          const mdx = node.x-mouse.x, mdy = node.y-mouse.y;
          const mdist = Math.sqrt(mdx*mdx+mdy*mdy);
          if(mdist < mouse.radius){
            ctx.strokeStyle = strokeColor + ((1-mdist/mouse.radius)*0.4) + ')';
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(node.x,node.y); ctx.lineTo(mouse.x,mouse.y); ctx.stroke();
          }
        }
      }
      requestAnimationFrame(animateWeb);
    }
    animateWeb();
  })();
</script>
